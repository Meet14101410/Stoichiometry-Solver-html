body {
  font-family: Arial, sans-serif;
  background: linear-gradient(to right, #1e3c72, #2a5298);
  text-align: center;
  color: white;
  padding-top: 60px;
}

h2 {
  letter-spacing: 2px;
}

input {
  padding: 8px;
  width: 180px;
  border: none;
  border-radius: 5px;
  margin-top: 10px;
}

button {
  padding: 8px 22px;
  margin-top: 15px;
  background: #f39c12;
  color: black;
  border: none;
  border-radius: 5px;
  cursor: pointer;
  font-weight: bold;
}

button:hover {
  background: #e67e22;
}

#output {
  margin-top: 20px;
  font-size: 18px;
}
