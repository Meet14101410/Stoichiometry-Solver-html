body {
  font-family: Arial, sans-serif;
  background: #eef2f3;
  text-align: center;
  padding-top: 60px;
}

h2 {
  color: #2c3e50;
}

h3 {
  color: #34495e;
}

input {
  width: 70px;
  padding: 6px;
  margin: 5px;
  text-align: center;
  border: 1px solid #bbb;
  border-radius: 5px;
}

button {
  padding: 8px 20px;
  background: #16a085;
  color: white;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}

button:hover {
  background: #138d75;
}

#result {
  margin-top: 15px;
  font-size: 18px;
  font-weight: bold;
}
