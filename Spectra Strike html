<!DOCTYPE html>
<html>
<head>
  <title>Spectra Strike</title>
</head>
<body>
  <h2>Spectra Strike</h2>
  <p>Identify the correct spectrum!</p>

  <label>Wavelength (nm):</label>
  <input type="number" id="wave" placeholder="Enter value">

  <br><br>

  <button onclick="check()">Strike!</button>

  <h3 id="output"></h3>

  <script>
    function check() {
      let w = document.getElementById("wave").value;
      document.getElementById("output").innerText =
        w >= 400 && w <= 700 ? "Visible Spectrum ⚡" : "Outside Visible Range ❌";
    }
  </script>
</body>
</html>
